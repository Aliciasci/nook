# Supabase project — required for auth and all data persistence.
# Get these from your project's Settings → API page on supabase.com.
# The anon key is a public, RLS-protected key: safe to ship in client code,
# never put the service_role key or DB password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Spotify Client ID for the "Ma journée" widget's Spotify integration.
# Not a secret — it's fine to set this in your hosting provider's env var UI
# or commit it. Create an app at https://developer.spotify.com/dashboard,
# then add this deployment's URL (e.g. https://your-domain.com/) as a
# Redirect URI in that app's settings.
#
# Set this once when you deploy Nook and every visitor can connect their own
# Spotify account with no setup on their end. Leave it unset for local dev —
# Settings will let you paste a Client ID for testing in your own browser.
VITE_SPOTIFY_CLIENT_ID=f126daa8f7994759977039480c8b4a4a
